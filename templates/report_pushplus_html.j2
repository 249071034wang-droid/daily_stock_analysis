<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ report_date }} 股票分析报告</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;background:#f5f6fa;color:#2d2926;font-size:14px;line-height:1.55}
.container{max-width:640px;margin:0 auto;background:#fff}
.header{background:linear-gradient(135deg,#1a73e8,#4a90d9);color:#fff;padding:16px 18px 12px;border-bottom:3px solid #e8a838}
.header h1{font-size:17px;font-weight:900;margin:0}
.header .sub{margin-top:5px;font-size:11px;opacity:.85;font-weight:600}
.summary-bar{display:flex;gap:4px;padding:10px 14px 8px;background:#fff;border-bottom:1px solid #eee;flex-wrap:wrap}
.sum-item{background:#f0f4ff;border-radius:5px;padding:5px 9px;font-size:11px;display:flex;align-items:center;gap:3px}
.sum-score{font-weight:800;font-size:13px;color:#e91e63}
.sum-name{font-weight:700;color:#333}
.sum-advice{color:#666}

.card{border:1.2px solid #e0e0e0;border-radius:7px;margin:8px 12px 10px;overflow:hidden}
.card-head{padding:11px 14px 8px;display:flex;align-items:center;flex-wrap:wrap;gap:6px;border-bottom:1px solid #f0f0f0;background:linear-gradient(180deg,#fafbff,#fff)}
.rank{width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;color:#fff;flex-shrink:0}
.r1{background:#e91e63}.r2{background:#ff5722}.r3{background:#ff9800}.rn{background:#90a4ae}
.stock-title{font-size:15px;font-weight:900;color:#1a1a1a}
.stock-code{font-size:10px;color:#999;font-weight:600}
.tags{margin-left:auto;display:flex;gap:3px;flex-wrap:wrap}
.tag{font-size:9px;font-weight:700;padding:2px 6px;border-radius:3px}
.tag-ind{background:#e8f5e9;color:#2e7d32}.tag-theme{background:#fff3e0;color:#e65100}.tag-risk{background:#fce4ec;color:#c62828}
.score-big{font-size:21px;font-weight:900;color:#e91e63;flex-shrink:0}
.section{padding:9px 14px;border-bottom:1px solid #f5f5f5}
.section:last-child{border-bottom:none}
.sec-title{font-size:12px;font-weight:800;color:#1565c0;margin-bottom:6px;display:flex;align-items:center;gap:4px}
.sec-title .ico{font-size:13px}
.info-grid{display:grid;grid-template-columns:auto 1fr;gap:4px 10px}
.info-label{font-size:11px;color:#888;font-weight:700;text-align:right;white-space:nowrap}
.info-val{font-size:11.5px;color:#333;line-height:1.45}
.one-sentence{background:#f0f4ff;border-left:3px solid #1a73e8;padding:7px 10px;font-size:12.5px;color:#1a237e;line-height:1.5;border-radius:0 5px 5px 0;margin-bottom:6px}
.time-tag{display:inline-block;background:#fff3e0;color:#e65100;font-size:10px;font-weight:700;padding:2px 7px;border-radius:3px}
.pos-table{width:100%;border-collapse:collapse;font-size:11px;margin-top:4px}
.pos-table td{padding:4px 6px;border:1px solid #eee}
.pos-table td:first-child{background:#fafafa;color:#555;font-weight:700;width:80px}
.mkt-table{width:100%;border-collapse:collapse;font-size:10.5px;margin-top:4px}
.mkt-table th{background:#37474f;color:#fff;padding:4px 3px;font-weight:700;text-align:center}
.mkt-table td{padding:3px 3px;border:1px solid #e0e0e0;text-align:center;color:#333}
.mkt-table .up{color:#c62828;font-weight:700}.mkt-table .down{color:#2e7d32;font-weight:700}
.data-row{display:flex;justify-content:space-between;padding:3px 0;font-size:11px;border-bottom:1px dashed #eee}
.data-row:last-child{border-bottom:none}
.data-lbl{color:#888;font-weight:600}
.data-val{color:#333;font-weight:700}
.sniper-table{width:100%;border-collapse:collapse;font-size:11px;margin-top:4px}
.sniper-table td{padding:5px 8px;border:1px solid #e0e0e0}
.sniper-table td:first-child{background:#fff8e1;color:#f57c00;font-weight:700;width:95px}
.check-list{list-style:none;padding:0}
.check-list li{font-size:11px;padding:3px 0;padding-left:18px;position:relative;line-height:1.45}
.check-list li::before{content:'';position:absolute;left:0;top:8px;width:5px;height:5px;border-radius:50%;background:#4caf50}
.check-fail li::before{background:#f44336}
.risk-item{background:#fef5f5;border-radius:4px;padding:5px 8px;font-size:11px;color:#b71c1c;margin:3px 0}
.cat-item{background:#f0fdf4;border-radius:4px;padding:5px 8px;font-size:11px;color:#1b5e20;margin:3px 0}
.footer{text-align:center;font-size:10.5px;color:#bbb;padding:12px 10px;border-top:1px solid #eee;margin-top:4px}
</style>
</head>
<body>
<div class="container">

<div class="header">
<h1>📈 {{ report_date }} {{ labels.dashboard_title }}</h1>
<div class="sub">共分析 {{ results|length }} 只 | 🟢{{ labels.buy_label }}:{{ buy_count }} 🟡{{ labels.watch_label }}:{{ hold_count }} 🔴{{ labels.sell_label }}:{{ sell_count }}</div>
</div>

{% if market_status_line %}
<div style="padding:6px 14px;font-size:11px;color:#555;background:#fffef8;border-bottom:1px solid #eee">{{ market_status_line }}</div>
{% endif %}

<!-- ===== 摘要行 ===== -->
<div class="summary-bar">
{% for e in enriched %}
<span class="sum-item">
<span style="{{ 'color:#e91e63' if e.result.sentiment_score and e.result.sentiment_score > 70 else ('#ff9800' if e.result.sentiment_score > 50 else '#888') }};font-weight:900">{{ e.signal_emoji }} {{ e.stock_name[:4] }}({{ e.result.code[-6:] }})
</span>
<span class="sum-score">{{ (e.result.sentiment_score|int) if e.result.sentiment_score else '-' }}</span>
<span class="sum-advice">{{ e.localized_operation_advice }}</span>
</span>
{% endfor %}
</div>

{% for e in enriched %}
{% set result = e.result %}
{% set dashboard = result.dashboard if result.dashboard else {} %}
{% set core = dashboard.get('core_conclusion') or {} %}
{% set battle = dashboard.get('battle_plan') or {} %}
{% set intel = dashboard.get('intelligence') or {} %}
{% set data_persp = dashboard.get('data_perspective') or {} %}
{% set phase_decision = dashboard.get('phase_decision') or {} %}
{% set snapshot = result.market_snapshot if result.market_snapshot else {} %}
{% set i = loop.index %}

<div class="card">

<!-- ===== 头部：股票名+评分 ===== -->
<div class="card-head">
<div class="rank{% if i==1 %} r1{% elif i==2 %} r2{% elif i==3 %} r3{% else %} rn{% endif %}">{{ i }}</div>
<span class="stock-title">{{ e.signal_emoji }} {{ e.stock_name }}</span><span class="stock-code">({{ result.code }})</span>
<div class="tags">
{% if intel.get('industry') %}<span class="tag tag-ind">{{ intel.industry[:8] }}</span>{% endif %}
{% if intel.get('theme') %}<span class="tag tag-theme">{{ intel.theme[:8] }}</span>{% endif %}
</div>
<span class="score-big">{{ (result.sentiment_score|int) if result.sentiment_score else '-' }}</span>
</div>

<!-- ===== 核心结论 ===== -->
<div class="section">
<div class="sec-title"><span class="ico">📌</span> 核心结论</div>
<div class="info-val" style="font-weight:700;color:#1a1a1a">{{ core.get('one_sentence', result.analysis_summary) or '' }}</div>
<div style="margin-top:5px;font-size:11.5px;color:#444"><b>{{ e.signal_emoji }} {{ e.signal_text }}</b> | {{ localize_trend_prediction(result.trend_prediction, report_language) }}
{% if core.get('time_sensitivity') %}&nbsp;&nbsp;<span class="time-tag">⏰ {{ core.time_sensitivity }}</span>{% endif %}
</div>
{% set pos_advice = core.get('position_advice', {}) %}
{% if pos_advice %}
<table class="pos-table" style="margin-top:6px">
<tr><td>🆕 未持仓</td><td>{{ pos_advice.get('no_position', '-') }}</td></tr>
<tr><td>💼 已持仓</td><td>{{ pos_advice.get('has_position', '-') }}</td></tr>
</table>
{% endif %}
</div>

<!-- ===== 重要信息速览 ===== -->
{% if intel %}
<div class="section">
<div class="sec-title"><span class="ico">📰</span> 重要信息速览
{% if intel.get('industry') or intel.get('theme') %}<span style="float:right;font-size:9px;font-weight:700;color:#888">{{ intel.industry or '' }} | {{ intel.theme or '' }}</span>{% endif %}
</div>
<div class="info-grid">
{% if intel.get('sentiment_summary') %}
<span class="info-label">💭 情绪面</span><span class="info-val">{{ intel.sentiment_summary }}</span>
{% endif %}
{% if intel.get('earnings_outlook') %}
<span class="info-label">📊 盈利展望</span><span class="info-val">{{ intel.earnings_outlook }}</span>
{% endif %}
{% if intel.get('risk_alerts') %}
<span class="info-label" style="color:#c62828">🚨 风险提示</span><span class="info-val">{% for alert in intel.risk_alerts[:2] %}{% if not loop.first %} / {% endif %}{{ alert[:60] }}{% endfor %}</span>
{% endif %}
{% if intel.get('positive_catalysts') %}
<span class="info-label" style="color:#2e7d32">✨ 催化因素</span><span class="info-val">{% for cat in intel.positive_catalysts[:2] %}{% if not loop.first %} · {% endif %}{{ cat[:60] }}{% endfor %}</span>
{% endif %}
{% if intel.get('latest_news') %}
<span class="info-label">📢 最新动态</span><span class="info-val">{{ intel.latest_news[:80] }}</span>
{% endif %}
</div>
</div>
{% endif %}

<!-- ===== 当日行情 ===== -->
{% if snapshot %}
<div class="section">
<div class="sec-title"><span class="ico">📈</span> 当日行情</div>
<table class="mkt-table">
<thead><tr>
<th>收盘</th><th>开盘</th><th>最高</th><th>最低</th><th>涨跌幅</th><th>振幅</th><th>成交量</th><th>成交额</th>
</tr></thead>
<tbody><tr>
<td>{{ snapshot.close or '-' }}</td>
<td>{{ snapshot.open or '-' }}</td>
<td>{{ snapshot.high or '-' }}</td>
<td>{{ snapshot.low or '-' }}</td>
<td class="{% if (snapshot.pct_chg or '').startswith('+') %}up{% elif (snapshot.pct_chg or '').startswith('-') %}down{% endif %}">{{ snapshot.pct_chg or '-' }}</td>
<td>{{ snapshot.amplitude or '-' }}</td>
<td>{{ snapshot.volume or '-' }}</td>
<td>{{ snapshot.amount or '-' }}</td>
</tr></tbody>
</table>
{% if snapshot.price or snapshot.volume_ratio %}
<table class="mkt-table" style="margin-top:4px">
<thead><tr>
<th>实时价</th><th>量比</th><th>换手率</th><th>PE(动态)</th><th>数据源</th>
</tr></thead>
<tbody><tr>
<td class="{% if (snapshot.volume_ratio|string|float) > 1.5 %}up{% endif %}">{{ snapshot.price or '-' }}</td>
<td class="{% if (snapshot.volume_ratio|string|float) > 1.5 %}up{% endif %}">{{ snapshot.volume_ratio or '-' }}</td>
<td>{{ snapshot.turnover_rate or '-' }}</td>
<td>{{ "{:.1f}".format(snapshot.pe_ratio) if snapshot.pe_ratio is not none else '-' }}</td>
<td style="font-size:9px">{{ snapshot.source or '-' }}</td>
</tr></tbody>
</table>
{% endif %}
</div>
{% endif %}

<!-- ===== 数据速览 ===== -->
{% if data_persp %}
<div class="section">
<div class="sec-title"><span class="ico">📊</span> 数据速览</div>
{% set trend_data = data_persp.get('trend_status', {}) %}
{% if trend_data %}
<div class="data-row"><span class="data-lbl">均线形态</span><span class="data-val">{{ trend_data.get('ma_alignment','-') }} | 强度 {{ trend_data.get('trend_score','-') }}/100</span></div>
{% endif %}
{% set price_data = data_persp.get('price_position', {}) %}
{% if price_data %}
<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:2px;font-size:10.5px;margin-top:4px">
<div style="text-align:center;background:#fafafa;padding:3px;border-radius:3px"><div style="color:#888;font-weight:600">当前价</div><div style="font-weight:800">{{ price_data.current_price or '-' }}</div></div>
<div style="text-align:center;background:#fafafa;padding:3px;border-radius:3px"><div style="color:#888;font-weight:600">MA5</div><div style="font-weight:800">{{ price_data.ma5 or '-' }}</div></div>
<div style="text-align:center;background:#fafafa;padding:3px;border-radius:3px"><div style="color:#888;font-weight:600">MA10</div><div style="font-weight:800">{{ price_data.ma10 or '-' }}</div></div>
<div style="text-align:center;background:#fafafa;padding:3px;border-radius:3px"><div style="color:#888;font-weight:600">MA20</div><div style="font-weight:800">{{ price_data.ma20 or '-' }}</div></div>
</div>
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:2px;font-size:10.5px;margin-top:3px">
<div style="text-align:center;background:#fff8e1;padding:3px;border-radius:3px"><div style="color:#888;font-weight:600">支撑位</div><div style="font-weight:800;color:#2e7d32">{{ price_data.support_level or '-' }}</div></div>
<div style="text-align:center;background:#fce4ec;padding:3px;border-radius:3px"><div style="color:#888;font-weight:600">压力位</div><div style="font-weight:800;color:#c62828">{{ price_data.resistance_level or '-' }}</div></div>
<div style="text-align:center;background:#f3e5f5;padding:3px;border-radius:3px"><div style="color:#888;font-weight:600">偏离MA5</div><div style="font-weight:800">{{ price_data.bias_ma5 }}{{ '%' if price_data.bias_ma5 is not none else '' }}</div></div>
</div>
{% endif %}
{% set vol_data = data_persp.get('volume_analysis', {}) %}
{% if vol_data %}
<div class="data-row" style="margin-top:4px"><span class="data-lbl">量能</span><span class="data-val">量比 <b>{{ vol_data.volume_ratio or '-' }}</b>（{{ vol_data.volume_status or '' }}）| 换手 {{ vol_data.turnover_rate or '-' }}%</span></div>
{% if vol_data.volume_meaning %}<div style="font-size:10px;color:#777;padding-left:0">💡 {{ vol_data.volume_meaning }}</div>{% endif %}
{% endif %}
{% set chip_data = data_persp.get('chip_structure', {}) %}
{% if chip_data and not is_chip_structure_unavailable(chip_data) %}
<div class="data-row"><span class="data-lbl">筹码结构</span><span class="data-val">获利盘 {{ chip_data.profit_ratio or '-' }} | 均价 {{ chip_data.avg_cost or '-' }} | 集中度 {{ chip_data.concentration or '-' }} {{ localize_chip_health(chip_data.chip_health, report_language) }}</span></div>
{% endif %}
</div>
{% endif %}

<!-- ===== 阶段决策 ===== -->
{% if phase_decision and (phase_decision.action_window or phase_decision.immediate_action or phase_decision.watch_conditions) %}
<div class="section">
<div class="sec-title"><span class="ico">🛡️</span> 阶段决策</div>
<table class="pos-table">
<tr><td>操作窗口</td><td>{{ phase_decision.action_window or '-' }}</td></tr>
<tr><td>立即动作</td><td>{{ phase_decision.immediate_action or '-' }}</td></tr>
<tr><td>下次检查</td><td>{{ phase_decision.next_check_time or '-' }}</td></tr>
</table>
{% if phase_decision.confidence_reason %}
<div style="margin-top:5px;font-size:11px"><b style="color:#1565c0">置信理由：</b>{{ phase_decision.confidence_reason }}</div>
{% endif %}
{% if phase_decision.data_limitations %}
<div style="margin-top:4px;font-size:10.5px;color:#e65100"><b>⚠️ 数据限制：</b>{% for lim in phase_decision.data_limitations %}{{ lim }}{% endfor %}</div>
{% endif %}
</div>
{% endif %}

<!-- ===== 作战计划 ===== -->
{% if battle %}
{% set sniper = battle.get('sniper_points', {}) %}
{% if sniper and (sniper.ideal_buy or sniper.stop_loss or sniper.take_profit) %}
<div class="section">
<div class="sec-title"><span class="ico">🎯</span> 作战计划</div>
<table class="sniper-table">
<tr><td>🎯 理想买入点</td><td>{{ clean_sniper(sniper.get('ideal_buy')) }}</td></tr>
{% if sniper.secondary_buy %}
<tr><td>🔵 次优买入点</td><td>{{ clean_sniper(sniper.secondary_buy) }}</td></tr>
{% endif %}
<tr><td>🛑 止损位</td><td style="color:#c62828;font-weight:800">{{ clean_sniper(sniper.stop_loss) }}</td></tr>
<tr><td>🎊 目标位</td><td style="color:#2e7d32;font-weight:800">{{ clean_sniper(sniper.take_profit) }}</td></tr>
</table>
{% set position = battle.position_strategy %}
{% if position %}
<div style="margin-top:6px;background:#f8f9ff;padding:6px 9px;border-radius:5px;font-size:11px">
<b style="color:#1565c0">💰 建议仓位：</b>{{ position.suggested_position or '-' }}
{% if position.entry_plan %}<br><b>入场计划：</b>{{ position.entry_plan }}{% endif %}
{% if position.risk_control %}<br><b>风控策略：</b>{{ position.risk_control }}{% endif %}
</div>
{% endif %}
</div>
{% endif %}

<!-- ===== 检查清单 ===== -->
{% set checklist = battle.get('action_checklist', []) %}
{% if checklist %}
<div class="section">
<div class="sec-title"><span class="ico">✅</span> 检查清单
<span style="float:right;font-size:10px;color:#888;font-weight:400">{{ checklist|length }}项</span></div>
<ul class="check-list{% if failed_checks(checklist) %} check-fail{% endif %}">
{% for item in checklist %}<li>{{ item }}</li>{% endfor %}
</ul>
</div>
{% endif %}
{% endif %}

<!-- ===== 兜底：无dashboard时的内容 ===== -->
{% if not dashboard %}
{% if result.buy_reason or result.risk_warning %}
<div class="section">
{% if result.buy_reason %}<div class="one-sentence">💡 操作理由：{{ result.buy_reason }}</div>{% endif %}
{% if result.risk_warning %}<div class="risk-item">⚠️ 风险提示：{{ result.risk_warning }}</div>{% endif %}
</div>
{% endif %}
{% endif %}

</div><!-- end card -->
{% endfor %}

<div class="footer">
{{ labels.generated_at_label }}：{{ report_timestamp[11:19] }}
{% if show_llm_model and models_used %} &nbsp;|&nbsp; {{ labels.analysis_model_label }}：{{ models_used|join(', ') }}{% endif %}
</div>

</div><!-- end container -->
</body>
</html>
